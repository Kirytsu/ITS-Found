generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

enum ReportStatus {
  UNVERIFIED  // FOUND only: waiting for admin physical verification
  PUBLISHED   // Visible to public (LOST defaults here; FOUND after verification)
  RESOLVED    // Item returned / claimed
  REJECTED    // Rejected by admin (spam / invalid)
}

// ─── Master Data (seeded) ─────────────────────────────────────────────────────

model Area {
  id            String     @id @default(cuid())
  name          String     @unique
  facilities    Facility[]
  reports       Report[]   @relation("PrimaryArea")
  taggedReports Report[]   @relation("ReportAreas")
}

model Facility {
  id      String  @id @default(cuid())
  name    String
  phone   String?
  address String?

  areaId  String
  area    Area     @relation(fields: [areaId], references: [id])
  reports Report[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  reports Report[]
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String         // hashed (bcryptjs)
  role          Role           @default(USER)
  reports       Report[]       @relation("AuthoredReports")
  verifiedReports Report[]     @relation("VerifiedReports")
  resolvedReports Report[]     @relation("ResolvedReports")
  notifications Notification[]
  claims        Claim[]
  createdAt     DateTime       @default(now())
}

model Report {
  id             String       @id @default(cuid())
  title          String       // e.g. "HP Xiaomi Redmi Note 9"
  type           ReportType
  status         ReportStatus

  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])

  // Primary area — FOUND: the single area; LOST: the first selected area (display fallback)
  areaId         String
  area           Area         @relation("PrimaryArea", fields: [areaId], references: [id])
  // All areas this report spans — FOUND: 1; LOST: 1..n. Used for filtering + smart match.
  areas          Area[]       @relation("ReportAreas")

  // Required for FOUND: the specific facility where the item is deposited
  facilityId     String?
  facility       Facility?    @relation(fields: [facilityId], references: [id])

  locationDetail String       // free-text: "Ruang 301", "Depan lift lantai 3"
  description    String
  incidentDate   DateTime
  imageUrl       String?      // stored under /public/uploads/

  authorId       String
  author         User         @relation("AuthoredReports", fields: [authorId], references: [id])

  verifiedAt     DateTime?
  verifiedById   String?
  verifiedBy     User?        @relation("VerifiedReports", fields: [verifiedById], references: [id])

  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("ResolvedReports", fields: [resolvedById], references: [id])

  takerName      String?      // Name of the person who claimed the item (for FOUND reports)
  takerPhone     String?
  takerIdCard    String?
  takerPhotoUrl  String?
  takerNotes     String?

  notifications  Notification[]
  claim          Claim?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Notification {
  id        String  @id @default(cuid())
  actionKey String  @default("match")
  isRead    Boolean @default(false)

  userId  String
  user    User    @relation(fields: [userId], references: [id])

  // The report that triggered the match notification
  matchedReportId String?
  matchedReport   Report?  @relation(fields: [matchedReportId], references: [id])

  createdAt DateTime @default(now())
}

model Claim {
  id        String   @id @default(cuid())
  reportId  String   @unique
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoUrl  String
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
